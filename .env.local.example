# 本地开发环境配置模板
# 复制此文件为 .env.local 并填入你的值
# .env.local 是个人本地配置，不要提交到Git

# ============================================
# 必需配置
# ============================================

# DashScope API 密钥（开发用）
# 从 https://dashscope.console.aliyun.com 获取
DASHSCOPE_API_KEY=sk-your_local_key_here

# ============================================
# PostgreSQL 本地开发配置
# ============================================

# 数据库主机（本地开发用localhost）
DB_HOST=localhost

# 数据库端口（PostgreSQL默认5432）
DB_PORT=5432

# 数据库用户名
DB_USER=postgres

# 数据库密码
DB_PASSWORD=postgres

# 数据库名称
DB_NAME=ai_coding_tutor_dev

# 或直接指定完整URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_coding_tutor_dev

# ============================================
# 开发环境标志
# ============================================

ENV=development

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================
# 可选配置 - 本地开发设置
# ============================================

# 日志级别（调试时设为DEBUG）
LOG_LEVEL=INFO

# API服务主机
API_HOST=0.0.0.0

# API服务端口
API_PORT=8000

# ✅ 安全提示:
# ✅ 不要提交此文件到Git - 它在.gitignore中
# ✅ 不要在此文件中存储生产密钥
# ✅ 保持此文件本地化，不要分享
# ✅ 定期轮换开发密钥

