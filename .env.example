# ============================================
# AI Coding Tutor 环境配置
# ============================================

# ============================================
# DashScope LLM 配置
# ============================================

# DashScope API 密钥 (从 https://dashscope.console.aliyun.com 获取)
DASHSCOPE_API_KEY=sk-xxxxx

# ============================================
# PostgreSQL 数据库配置
# ============================================

# 数据库主机
DB_HOST=localhost

# 数据库端口
DB_PORT=5432

# 数据库用户名
DB_USER=postgres

# 数据库密码
DB_PASSWORD=postgres

# 数据库名称
DB_NAME=ai_coding_tutor

# 完整数据库URL (可选，如指定则覆盖上面的配置)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_coding_tutor

# ============================================
# 应用配置
# ============================================

# 应用环境 (development/production)
ENV=development

# Python 环境标志
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================
# 可选配置
# ============================================

# 日志级别
# LOG_LEVEL=DEBUG

# API服务主机
# API_HOST=0.0.0.0

# API服务端口
# API_PORT=8000
